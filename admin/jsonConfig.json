{
  "i18n": true,
  "type": "tabs",
  "items": {
    "connection": {
      "type": "panel",
      "label": "Connection",
      "items": {
        "apiKey": {
          "type": "password",
          "label": "OpenAirLog API key",
          "help": "A read-only OpenAirLog API key with the flights:read permission.",
          "encrypted": true
        },
        "homebase": {
          "type": "text",
          "label": "Homebase (ICAO)",
          "help": "Four-letter ICAO airport code, e.g. EDDF for Frankfurt or EDDM for Munich.",
          "default": "EDDF",
          "maxLength": 4,
          "validator": "!!data.homebase && /^[A-Za-z]{4}$/.test(data.homebase)"
        },
        "interval": {
          "type": "number",
          "label": "Polling interval",
          "min": 5,
          "max": 1440,
          "default": 15,
          "unit": "min"
        }
      }
    }
  }
}